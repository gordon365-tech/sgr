# SGR Environment Template for Production
#
# IMPORTANT: 
# - Never commit actual .env files with secrets to Git
# - Copy this to .env.prod and fill in real values
# - Restrict file permissions: chmod 600 .env.prod
# - Use Secret Manager in Kubernetes/Cloud

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=sgr
DB_PASSWORD=change_me_production_strong_password_here
DB_NAME=sgr
DB_POOL_SIZE=20
DB_POOL_MAX_OVERFLOW=10

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=  # Leave empty if no password set
REDIS_DB=0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
ENVIRONMENT=production
TRADING_MODE=paper

# Security
SECRET_KEY=generate_strong_secret_here_min_32_chars
ENCRYPTION_MASTER_KEY=generate_encryption_key_32_chars

# Exchange Credentials (Paper/Live modes)
# NEVER use real LIVE credentials in default .env
# Production: use Kubernetes Secrets or AWS Secrets Manager

# Pionex (Paper Trading - no credentials needed)
PIONEX_PAPER_API_KEY=
PIONEX_PAPER_API_SECRET=

# Pionex (Live Trading - ONLY after full validation)
# Keep commented/empty by default
PIONEX_LIVE_API_KEY=
PIONEX_LIVE_API_SECRET=

# Risk Management Limits
RISK_MAX_PORTFOLIO_DRAWDOWN=0.15
RISK_DAILY_LOSS_LIMIT=0.05
RISK_MAX_SINGLE_POSITION_PCT=0.05
RISK_VAR_95_LIMIT=0.03
RISK_PORTFOLIO_HEAT_LIMIT=0.70
RISK_MAX_LEVERAGE=3.0
RISK_MAX_OPEN_POSITIONS=10

# Logging & Monitoring
LOG_LEVEL=info
LOG_FORMAT=json

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin_password
GRAFANA_ADMIN_USER=admin

# Sentry (Optional - Error Tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Telegram Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# HTTP Timeouts
HTTP_TIMEOUT_SECONDS=30
EXCHANGE_TIMEOUT_SECONDS=15
DB_POOL_TIMEOUT_SECONDS=10

# Circuit Breaker (Exchange Resilience)
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=60

# Kill Switch
# Set to "true" to initialize in ACTIVE state (no trading until manually reset)
KILL_SWITCH_ENABLED_ON_STARTUP=false

# Feature Store
FEATURE_STORE_TTL_SECONDS=3600

# Backtesting Mode (if enabled)
# BACKTESTING_ENABLED=false
