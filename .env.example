# =============================================================================
# Project SGR – Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to git.
# =============================================================================

# ---------------------------------------------------------------------------
# System
# ---------------------------------------------------------------------------
ENVIRONMENT=development           # development | staging | production
TRADING_MODE=paper                # paper | live  (default: paper – always start here)
APP_NAME=SGR
VERSION=0.1.0

# ---------------------------------------------------------------------------
# Database (TimescaleDB / PostgreSQL)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433                      # Host-Port aus docker-compose.yml (Container intern: 5432)
DB_NAME=sgr
DB_USER=sgr
DB_PASSWORD=changeme
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
API_SECRET_KEY=change-me-in-production-min-32-chars
API_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_REFRESH_TOKEN_EXPIRE_DAYS=30
API_CORS_ORIGINS=["http://localhost:3000"]
API_RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Encryption (for API keys at rest)
# ---------------------------------------------------------------------------
ENCRYPTION_MASTER_KEY=change-me-32-byte-key-for-prod!!

# ---------------------------------------------------------------------------
# Risk Limits
# ---------------------------------------------------------------------------
RISK_MAX_PORTFOLIO_DRAWDOWN=0.15   # 15% → Kill Switch
RISK_DAILY_LOSS_LIMIT=0.05         # 5% daily loss → pause trading
RISK_MAX_SINGLE_POSITION_PCT=0.10  # 10% max per position
RISK_VAR_95_LIMIT=0.03             # 3% VaR limit
RISK_PORTFOLIO_HEAT_LIMIT=0.70     # 70% portfolio heat
RISK_MAX_LEVERAGE=3.0
RISK_MAX_OPEN_POSITIONS=10

# ---------------------------------------------------------------------------
# Exchange API Keys – Paper Trading (Testnet)
# ---------------------------------------------------------------------------
BINANCE_PAPER_API_KEY=
BINANCE_PAPER_SECRET=
BINANCE_PAPER_TESTNET=true

PIONEX_PAPER_API_KEY=
PIONEX_PAPER_SECRET=

# ---------------------------------------------------------------------------
# Exchange API Keys – Live Trading
# WARNING: Only set these when ALL Go-Live Gates are passed.
# ---------------------------------------------------------------------------
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_SECRET=

PIONEX_LIVE_API_KEY=
PIONEX_LIVE_SECRET=

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
MONITORING_PROMETHEUS_PORT=9090
MONITORING_LOG_LEVEL=INFO
MONITORING_ENABLE_TRACING=true

# Optional: Telegram alerts for critical events
MONITORING_TELEGRAM_BOT_TOKEN=
MONITORING_TELEGRAM_CHAT_ID=

# Optional: Sentry for error tracking
MONITORING_SENTRY_DSN=
