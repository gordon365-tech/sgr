+"""
+Tests für sgr.saas.auth.AuthService.
+
+Coverage-Ziel: 49% -> hoch.
+
+Teststrategie:
+    - Passwort-Hashing/-Stärke, JWT-Tokens und TOTP werden REAL getestet
+      (passlib/python-jose/pyotp sind in der Umgebung installiert) statt
+      gemockt, da echte Roundtrips (hash -> verify, encode -> decode,
+      generate -> verify) robuster sind als Mock-Ketten und Regressionen
+      in der tatsächlichen Kryptographie zuverlässiger aufdecken.
+    - register_user()/login()/setup_2fa()/enable_2fa() benötigen die
+      DB-Schicht (get_repositories(), get_session()) und werden daher
+      mit AsyncMock/MagicMock isoliert getestet, analog zum etablierten
+      Muster in tests/unit/test_event_bus.py und
+      tests/exchanges/test_ccxt_base.py für Module mit externer
+      Infrastruktur-Abhängigkeit.
+"""
+
+from __future__ import annotations
+
+from contextlib import asynccontextmanager
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+
+from sgr.core.types import TradingMode
+from sgr.saas.auth import AuthService
+
+
+@pytest.fixture
+def auth() -> AuthService:
+    return AuthService()
+
+
+# ---------------------------------------------------------------------
+# Password
+# ---------------------------------------------------------------------
+
+
+class TestPassword:
+    def test_hash_password_produces_verifiable_hash(self, auth: AuthService) -> None:
+        hashed = auth.hash_password("SuperSecret123!")
+        assert hashed != "SuperSecret123!"
+        assert auth.verify_password("SuperSecret123!", hashed) is True
+
+    def test_verify_password_rejects_wrong_password(self, auth: AuthService) -> None:
+        hashed = auth.hash_password("SuperSecret123!")
+        assert auth.verify_password("WrongPassword", hashed) is False
+
+    def test_verify_password_returns_false_on_malformed_hash(self, auth: AuthService) -> None:
+        assert auth.verify_password("anything", "not-a-real-hash") is False
+
+    def test_validate_password_strength_accepts_strong_password(
+        self, auth: AuthService
+    ) -> None:
+        errors = auth.validate_password_strength("Str0ng!Passw0rd")
+        assert errors == []
+
+    def test_validate_password_strength_flags_too_short(self, auth: AuthService) -> None:
+        errors = auth.validate_password_strength("Sh0rt!")
+        assert any("12 characters" in e for e in errors)
+
+    def test_validate_password_strength_flags_missing_uppercase(
+        self, auth: AuthService
+    ) -> None:
+        errors = auth.validate_password_strength("lowercase123!!!!")
+        assert any("uppercase" in e for e in errors)
+
+    def test_validate_password_strength_flags_missing_lowercase(
+        self, auth: AuthService
+    ) -> None:
+        errors = auth.validate_password_strength("UPPERCASE123!!!!")
+        assert any("lowercase" in e for e in errors)
+
+    def test_validate_password_strength_flags_missing_digit(self, auth: AuthService) -> None:
+        errors = auth.validate_password_strength("NoDigitsHere!!!!")
+        assert any("digit" in e for e in errors)
+
+    def test_validate_password_strength_flags_missing_special_char(
+        self, auth: AuthService
+    ) -> None:
+        errors = auth.validate_password_strength("NoSpecialChar123")
+        assert any("special character" in e for e in errors)
+
+
+# ---------------------------------------------------------------------
+# JWT Tokens
+# ---------------------------------------------------------------------
+
+
+class TestTokens:
+    def test_create_and_decode_access_token(self, auth: AuthService) -> None:
+        token = auth.create_access_token("user-1", TradingMode.PAPER)
+        payload = auth.decode_token(token)
+
+        assert payload["sub"] == "user-1"
+        assert payload["trading_mode"] == TradingMode.PAPER.value
+        assert payload["is_admin"] is False
+        assert payload["type"] == "access"
+
+    def test_create_access_token_with_admin_and_extra_claims(self, auth: AuthService) -> None:
+        token = auth.create_access_token(
+            "user-1", TradingMode.LIVE, is_admin=True, extra_claims={"tenant": "acme"}
+        )
+        payload = auth.decode_token(token)
+
+        assert payload["is_admin"] is True
+        assert payload["tenant"] == "acme"
+
+    def test_create_and_decode_refresh_token(self, auth: AuthService) -> None:
+        token = auth.create_refresh_token("user-1")
+        payload = auth.decode_token(token)
+
+        assert payload["sub"] == "user-1"
+        assert payload["type"] == "refresh"
+
+    def test_decode_token_raises_on_garbage(self, auth: AuthService) -> None:
+        with pytest.raises(ValueError, match="Invalid token"):
+            auth.decode_token("not-a-jwt-at-all")
+
+    def test_verify_access_token_accepts_access_token(self, auth: AuthService) -> None:
+        token = auth.create_access_token("user-1", TradingMode.PAPER)
+        payload = auth.verify_access_token(token)
+        assert payload["sub"] == "user-1"
+
+    def test_verify_access_token_rejects_refresh_token(self, auth: AuthService) -> None:
+        token = auth.create_refresh_token("user-1")
+        with pytest.raises(ValueError, match="Not an access token"):
+            auth.verify_access_token(token)
+
+    def test_verify_refresh_token_returns_user_id(self, auth: AuthService) -> None:
+        token = auth.create_refresh_token("user-42")
+        assert auth.verify_refresh_token(token) == "user-42"
+
+    def test_verify_refresh_token_rejects_access_token(self, auth: AuthService) -> None:
+        token = auth.create_access_token("user-1", TradingMode.PAPER)
+        with pytest.raises(ValueError, match="Not a refresh token"):
+            auth.verify_refresh_token(token)
+
+
+# ---------------------------------------------------------------------
+# TOTP / 2FA (crypto-level helpers)
+# ---------------------------------------------------------------------
+
+
+class TestTotpHelpers:
+    def test_generate_totp_secret_returns_base32_string(self, auth: AuthService) -> None:
+        secret = auth.generate_totp_secret()
+        assert isinstance(secret, str)
+        assert len(secret) >= 16
+
+    def test_get_totp_uri_contains_issuer_and_email(self, auth: AuthService) -> None:
+        secret = auth.generate_totp_secret()
+        uri = auth.get_totp_uri(secret, "trader@example.com")
+
+        assert uri.startswith("otpauth://totp/")
+        assert "ProjectSGR" in uri
+        assert "trader%40example.com" in uri or "trader@example.com" in uri
+
+    def test_verify_totp_accepts_valid_code(self, auth: AuthService) -> None:
+        import pyotp
+
+        secret = auth.generate_totp_secret()
+        code = pyotp.TOTP(secret).now()
+
+        assert auth.verify_totp(secret, code) is True
+
+    def test_verify_totp_rejects_invalid_code(self, auth: AuthService) -> None:
+        secret = auth.generate_totp_secret()
+        assert auth.verify_totp(secret, "000000") is False
+
+    def test_verify_totp_returns_false_on_malformed_secret(self, auth: AuthService) -> None:
+        assert auth.verify_totp("not-a-valid-base32-secret!!", "123456") is False
+
+    def test_encrypt_decrypt_totp_secret_roundtrip(self, auth: AuthService) -> None:
+        secret = auth.generate_totp_secret()
+        encrypted = auth.encrypt_totp_secret(secret)
+
+        assert encrypted != secret
+        assert auth.decrypt_totp_secret(encrypted) == secret
+
+
+# ---------------------------------------------------------------------
+# register_user()
+# ---------------------------------------------------------------------
+
+
+@pytest.mark.asyncio
+class TestRegisterUser:
+    async def test_register_user_rejects_weak_password(self, auth: AuthService) -> None:
+        with pytest.raises(ValueError, match="Weak password"):
+            await auth.register_user("new@example.com", "weak")
+
+    async def test_register_user_rejects_duplicate_email(self, auth: AuthService) -> None:
+        repos = MagicMock()
+        repos.users.get_by_email = AsyncMock(return_value={"id": "existing-user"})
+
+        with patch("sgr.core.repositories.get_repositories", return_value=repos):
+            with pytest.raises(ValueError, match="already registered"):
+                await auth.register_user("new@example.com", "Str0ng!Passw0rd")
+
+    async def test_register_user_success_returns_tokens(self, auth: AuthService) -> None:
+        repos = MagicMock()
+        repos.users.get_by_email = AsyncMock(return_value=None)
+        repos.users.create = AsyncMock(return_value="new-user-id")
+
+        with patch("sgr.core.repositories.get_repositories", return_value=repos):
+            result = await auth.register_user(
+                "new@example.com", "Str0ng!Passw0rd", trading_mode=TradingMode.PAPER
+            )
+
+        assert result["user_id"] == "new-user-id"
+        assert result["token_type"] == "bearer"
+        assert result["trading_mode"] == TradingMode.PAPER.value
+        assert auth.decode_token(result["access_token"])["sub"] == "new-user-id"
+
+
+# ---------------------------------------------------------------------
+# login()
+# ---------------------------------------------------------------------
+
+
+def _make_user(
+    *,
+    user_id: str = "user-1",
+    hashed_password: str,
+    is_active: bool = True,
+    is_2fa_enabled: bool = False,
+    totp_secret: str | None = None,
+    trading_mode: str = TradingMode.PAPER.value,
+) -> dict:
+    return {
+        "id": user_id,
+        "email": "trader@example.com",
+        "hashed_password": hashed_password,
+        "is_active": is_active,
+        "is_2fa_enabled": is_2fa_enabled,
+        "totp_secret": totp_secret,
+        "trading_mode": trading_mode,
+    }
+
+
+@pytest.mark.asyncio
+class TestLogin:
+    async def test_login_rejects_unknown_email(self, auth: AuthService) -> None:
+        repos = MagicMock()
+        repos.users.get_by_email = AsyncMock(return_value=None)
+
+        with patch("sgr.core.repositories.get_repositories", return_value=repos):
+            with pytest.raises(ValueError, match="Invalid credentials"):
+                await auth.login("nobody@example.com", "whatever")
+
+    async def test_login_rejects_wrong_password(self, auth: AuthService) -> None:
+        hashed = auth.hash_password("CorrectPass123!")
+        repos = MagicMock()
+        repos.users.get_by_email = AsyncMock(return_value=_make_user(hashed_password=hashed))
+
+        with patch("sgr.core.repositories.get_repositories", return_value=repos):
+            with pytest.raises(ValueError, match="Invalid credentials"):
+                await auth.login("trader@example.com", "WrongPass")
+
+    async def test_login_rejects_deactivated_account(self, auth: AuthService) -> None:
+        hashed = auth.hash_password("CorrectPass123!")
+        repos = MagicMock()
+        repos.users.get_by_email = AsyncMock(
+            return_value=_make_user(hashed_password=hashed, is_active=False)
+        )
+
+        with patch("sgr.core.repositories.get_repositories", return_value=repos):
+            with pytest.raises(ValueError, match="deactivated"):
+                await auth.login("trader@example.com", "CorrectPass123!")
+
+    async def test_login_success_without_2fa(self, auth: AuthService) -> None:
+        hashed = auth.hash_password("CorrectPass123!")
+        repos = MagicMock()
+        repos.users.get_by_email = AsyncMock(return_value=_make_user(hashed_password=hashed))
+        repos.users.update_last_login = AsyncMock()
+
+        with patch("sgr.core.repositories.get_repositories", return_value=repos):
+            result = await auth.login("trader@example.com", "CorrectPass123!")
+
+        assert result["user_id"] == "user-1"
+        repos.users.update_last_login.assert_awaited_once_with("user-1")
+
+    async def test_login_requires_totp_code_when_2fa_enabled(self, auth: AuthService) -> None:
+        hashed = auth.hash_password("CorrectPass123!")
+        repos = MagicMock()
+        repos.users.get_by_email = AsyncMock(
+            return_value=_make_user(
+                hashed_password=hashed, is_2fa_enabled=True, totp_secret="encrypted-secret"
+            )
+        )
+
+        with patch("sgr.core.repositories.get_repositories", return_value=repos):
+            with pytest.raises(ValueError, match="2FA code required"):
+                await auth.login("trader@example.com", "CorrectPass123!")
+
+    async def test_login_rejects_2fa_enabled_without_configured_secret(
+        self, auth: AuthService
+    ) -> None:
+        hashed = auth.hash_password("CorrectPass123!")
+        repos = MagicMock()
+        repos.users.get_by_email = AsyncMock(
+            return_value=_make_user(
+                hashed_password=hashed, is_2fa_enabled=True, totp_secret=""
+            )
+        )
+
+        with patch("sgr.core.repositories.get_repositories", return_value=repos):
+            with pytest.raises(ValueError, match="not properly configured"):
+                await auth.login("trader@example.com", "CorrectPass123!", totp_code="123456")
+
+    async def test_login_rejects_invalid_totp_code(self, auth: AuthService) -> None:
+        hashed = auth.hash_password("CorrectPass123!")
+        encrypted_secret = auth.encrypt_totp_secret(auth.generate_totp_secret())
+        repos = MagicMock()
+        repos.users.get_by_email = AsyncMock(
+            return_value=_make_user(
+                hashed_password=hashed, is_2fa_enabled=True, totp_secret=encrypted_secret
+            )
+        )
+
+        with patch("sgr.core.repositories.get_repositories", return_value=repos):
+            with pytest.raises(ValueError, match="Invalid 2FA code"):
+                await auth.login(
+                    "trader@example.com", "CorrectPass123!", totp_code="000000"
+                )
+
+    async def test_login_success_with_valid_totp_code(self, auth: AuthService) -> None:
+        import pyotp
+
+        hashed = auth.hash_password("CorrectPass123!")
+        secret = auth.generate_totp_secret()
+        encrypted_secret = auth.encrypt_totp_secret(secret)
+        code = pyotp.TOTP(secret).now()
+
+        repos = MagicMock()
+        repos.users.get_by_email = AsyncMock(
+            return_value=_make_user(
+                hashed_password=hashed, is_2fa_enabled=True, totp_secret=encrypted_secret
+            )
+        )
+        repos.users.update_last_login = AsyncMock()
+
+        with patch("sgr.core.repositories.get_repositories", return_value=repos):
+            result = await auth.login(
+                "trader@example.com", "CorrectPass123!", totp_code=code
+            )
+
+        assert result["user_id"] == "user-1"
+
+
+# ---------------------------------------------------------------------
+# setup_2fa() / enable_2fa()
+# ---------------------------------------------------------------------
+
+
+def _fake_session_cm(session: MagicMock):
+    @asynccontextmanager
+    async def _cm():
+        yield session
+
+    return _cm
+
+
+@pytest.mark.asyncio
+class TestSetup2FA:
+    async def test_setup_2fa_returns_secret_and_uri(self, auth: AuthService) -> None:
+        session = MagicMock()
+        session.execute = AsyncMock()
+
+        with (
+            patch("sgr.core.repositories.get_repositories", return_value=MagicMock()),
+            patch("sgr.core.database.get_session", _fake_session_cm(session)),
+        ):
+            result = await auth.setup_2fa("user-1", "trader@example.com")
+
+        assert "secret" in result
+        assert result["totp_uri"].startswith("otpauth://totp/")
+        session.execute.assert_awaited_once()
+
+
+@pytest.mark.asyncio
+class TestEnable2FA:
+    async def test_enable_2fa_returns_false_when_user_missing(self, auth: AuthService) -> None:
+        session = MagicMock()
+        result_mock = MagicMock()
+        result_mock.scalar_one_or_none.return_value = None
+        session.execute = AsyncMock(return_value=result_mock)
+
+        with patch("sgr.core.database.get_session", _fake_session_cm(session)):
+            enabled = await auth.enable_2fa("user-1", "123456")
+
+        assert enabled is False
+
+    async def test_enable_2fa_returns_false_when_no_totp_secret_configured(
+        self, auth: AuthService
+    ) -> None:
+        session = MagicMock()
+        user = MagicMock()
+        user.totp_secret = None
+        result_mock = MagicMock()
+        result_mock.scalar_one_or_none.return_value = user
+        session.execute = AsyncMock(return_value=result_mock)
+
+        with patch("sgr.core.database.get_session", _fake_session_cm(session)):
+            enabled = await auth.enable_2fa("user-1", "123456")
+
+        assert enabled is False
+
+    async def test_enable_2fa_returns_false_on_invalid_code(self, auth: AuthService) -> None:
+        secret = auth.generate_totp_secret()
+        encrypted = auth.encrypt_totp_secret(secret)
+
+        session = MagicMock()
+        user = MagicMock()
+        user.totp_secret = encrypted
+        result_mock = MagicMock()
+        result_mock.scalar_one_or_none.return_value = user
+        session.execute = AsyncMock(return_value=result_mock)
+
+        with patch("sgr.core.database.get_session", _fake_session_cm(session)):
+            enabled = await auth.enable_2fa("user-1", "000000")
+
+        assert enabled is False
+
+    async def test_enable_2fa_succeeds_with_valid_code(self, auth: AuthService) -> None:
+        import pyotp
+
+        secret = auth.generate_totp_secret()
+        encrypted = auth.encrypt_totp_secret(secret)
+        code = pyotp.TOTP(secret).now()
+
+        session = MagicMock()
+        user = MagicMock()
+        user.totp_secret = encrypted
+        result_mock = MagicMock()
+        result_mock.scalar_one_or_none.return_value = user
+        session.execute = AsyncMock(return_value=result_mock)
+
+        with patch("sgr.core.database.get_session", _fake_session_cm(session)):
+            enabled = await auth.enable_2fa("user-1", code)
+
+        assert enabled is True
+        # execute() called twice: once for select, once for the update.
+        assert session.execute.await_count == 2
