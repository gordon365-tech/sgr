# SGR Trading Worker - separater Container für async Trading Jobs
# 
# Dieser Container läuft den Trading Worker (nicht die API)
# Wird als TradingWorker.Dockerfile gebaut, shared denselben Base wie API
# Kann unabhängig von der API skaliert, restartet oder deployed werden

FROM sgr-api:latest as app-base

# Override CMD für Worker-Modus
# Der Worker lädt dieselbe Application aber startet mit einem
# alternativen Entry Point (z.B. sgr.worker.main:run_trading_worker)
# oder mit einem speziellen Signal Handler für Trading Lifecycle

COPY --chown=sgr:sgr sgr/worker/main.py /app/sgr/worker/
# Hinweis: sgr/worker/signal_handler.py existiert aktuell nicht im Repo
# (sgr/worker/ enthaelt nur __init__.py + main.py) - diese Zeile wurde
# entfernt, da der Build sonst mit COPY failed: file not found abbricht.

# Worker kann spezifische Ressourcen-Limits definieren
# (wird in docker-compose.yml / Kubernetes definiert, nicht hier)

# Healthcheck: ueberschreibt explizit den vom sgr-api-Base-Image geerbten
# HTTP-Check (curl gegen localhost:8000/health/live). Der Worker exponiert
# bewusst keinen HTTP-Port (siehe docker-compose.prod.yml: "NO ports
# exposed - internal only"), weshalb der geerbte Check immer mit
# "Failed to connect to localhost port 8000" fehlschlug, obwohl der
# Worker-Prozess funktional lief (unhealthy trotz sauberem worker.ready).
#
# Stattdessen wird ein Datei-basierter Liveness-Marker geprueft, den
# sgr/worker/main.py periodisch aktualisiert (siehe HEARTBEAT_PATH /
# HEARTBEAT_INTERVAL_SECONDS dort). "-mmin -1" (juenger als 60s) erlaubt
# bis zu vier verpasste 15s-Heartbeat-Intervalle, bevor retries=3 den
# Container als unhealthy markiert.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD find /tmp/worker_heartbeat -mmin -1 | grep -q . || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]

# Worker läuft mit spezialisiertem Entry Point
CMD ["python", "-m", "sgr.worker.main"]
